# Ignore Source Repositories (Only deploy scripts and static files are tracked)
chengflow/
chengflow-ui/
chengflow-app/
chengapp/
chenghub/
skill-package-spec/
skill-registry/

# Ignore Build & Staging Directories
dist/
dist.bak/
deploy/bin/cheng-api
deploy/bin/chengctl

# Ignore Project Meta & IDE Files
.agents/
.claude/
.codex
CLAUDE.md
RELEASE_WORKFLOW.md

# Ignore Local Configs & Variables
.env
.chengos_lang
# Holds a ChengHub bearer token in plaintext — must never be committed.
.mcp.json

# Ignore per-installation release state written by chengos.sh.
# NOTE: this must never cover release metadata that is meant to be published —
# /VERSION, /CHANGELOG.md, and generated .sha256/.sig assets stay tracked or
# uploaded as Release assets.
.chengos_version
.chengos_docker_version
.chengos_install_mode
.chengos_modules
.chengos_cli_target
.chengos_backups/
deploy/.env
deploy/hybrid/.env
deploy/hybrid/install/.env
deploy/docker/.env
deploy/distributed/.env

# Ignore Runtime State & Process IDs
**/runtime/*.pid
**/runtime/pg-data/
**/runtime/qdrant-storage/
**/runtime/redis-data/
**/runtime/data/

# Ignore FileOps Backup Directories
**/.cheng-file-ops-backups/

# Ignore Dependency Libraries
**/node_modules/
**/target/

# Ignore Service Logs
**/logs/*.log
**/logs/*.out
**/logs/*.err
nohup.out
