# ChengHub local development environment. Copy to .env and adjust.
# Every variable here overrides the corresponding config/default.toml value.

# --- Core ---------------------------------------------------------------
CHENGHUB_ENVIRONMENT=development
CHENGHUB_LISTEN=127.0.0.1:8400
CHENGHUB_PUBLIC_URL=http://127.0.0.1:8400

# --- Persistence ----------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/chenghub
REDIS_URL=redis://127.0.0.1:6379/1
CHENGHUB_REDIS_ENABLED=true

# --- Secrets ----------------------------------------------------------------
# >= 32 chars in production; the dev default is refused there.
CHENGHUB_TOKEN_HMAC_SECRET=

# --- OAuth providers (a provider is enabled when both values are set) ----
CHENGHUB_GITHUB_CLIENT_ID=
CHENGHUB_GITHUB_CLIENT_SECRET=
CHENGHUB_WECHAT_APP_ID=
CHENGHUB_WECHAT_APP_SECRET=
# QQ stays disabled unless configured (provider-abstraction proof).
CHENGHUB_QQ_APP_ID=
CHENGHUB_QQ_APP_SECRET=

# --- Browser / CORS -----------------------------------------------------
# Comma-separated exact origins allowed to call the API from a browser.
CHENGHUB_CORS_ALLOWED_ORIGINS=
# Absolute return_to origins allowed after login (e.g. the local ChengFlow
# UI dev server): http://localhost:5173
CHENGHUB_ALLOWED_RETURN_ORIGINS=
CHENGHUB_COOKIE_DOMAIN=
CHENGHUB_COOKIE_SECURE=false

# --- Bootstrap ------------------------------------------------------------
# Usernames auto-granted the admin role on their first OAuth login.
CHENGHUB_BOOTSTRAP_ADMINS=

# --- Operations ------------------------------------------------------------
CHENGHUB_RUN_JOBS=true
CHENGHUB_LOG_FORMAT=pretty

# --- Tests ------------------------------------------------------------------
# Integration tests run only when this is set (a scratch database!).
# CHENGHUB_TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/chenghub_test
