# Caddy reverse proxy for ChengHub.
#
# Local compose stack listens on :8080 without TLS. For production replace
# the site address with your domain — Caddy then provisions TLS
# automatically:
#
#   hub.example.com {
#       reverse_proxy chenghub:8400
#   }

:8080 {
    encode gzip

    reverse_proxy chenghub:8400 {
        # Overwrite inbound client-ip headers so rate limiting cannot be
        # spoofed through the proxy.
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
