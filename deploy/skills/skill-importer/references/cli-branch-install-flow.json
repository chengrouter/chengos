{
  "workflowId": "8d2b9c0e-9b56-4c41-9f41-3cdd8c6f7e21",
  "name": "CLI Branch To Install Flow",
  "description": "CLI subgraph starting from the LLM branch output. The main path threads a single unified context object (context_out -> context) through cli_context_init -> cli_install_plan -> validate -> cli_install. On failure, cli_fallback_context builds a redacted diagnostic + LLM prompt, the fallback LLM authors a new install.yaml, cli_fallback_response_parse merges it back, and a second validate -> install runs it. Legacy scalar ports are retained on each node for debugging only; the official path uses context.",
  "state": "draft",
  "nodeCount": 10,
  "edgeCount": 11,
  "version": 2,
  "tags": ["skill-importer", "cli", "branch", "context", "example"],
  "visibility": "private",
  "skipValidation": true,
