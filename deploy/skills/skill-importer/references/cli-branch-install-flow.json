{
  "workflowId": "8d2b9c0e-9b56-4c41-9f41-3cdd8c6f7e21",
  "name": "CLI Install Flow",
  "description": "The LLM extracts only cli_name. tools/cli_install performs trusted-index lookup, manifest construction and validation, ordered check/install/verify execution, and per-step approval internally. Index misses return status=not_found without an LLM fallback.",
  "state": "draft",
  "nodeCount": 4,
  "edgeCount": 3,
  "version": 3,
  "tags": ["skill-importer", "cli", "deterministic", "example"],
  "visibility": "private",
  "skipValidation": true,
  "definition": {
    "nodes": [
      {
        "nodeId": "f1a0c0a0-6b3c-4c9f-9d0a-0c6d4f8f7a11",
        "nodeType": "chat/input",
        "name": "CLI Install Request",
        "position": { "x": 40, "y": 200 },
        "config": {}
      },
      {
        "nodeId": "c3d4e5f6-0002-4a00-9000-000000000002",
        "nodeType": "ai/llm",
        "name": "Extract CLI Name",
        "position": { "x": 360, "y": 200 },
        "config": {
          "instruction_prompt": "Return only the CLI executable name requested by the user, for example gh, jq, or rg. Do not return commands, JSON, Markdown, or explanations."
        }
      },
      {
        "nodeId": "2c9b7ec8-df4f-4dbe-8ac5-2fa1b76595f2",
        "nodeType": "tools/cli_install",
        "name": "CLI Install",
        "position": { "x": 680, "y": 200 },
        "config": {}
      },
      {
        "nodeId": "f6a7b8c9-0005-4a00-9000-000000000005",
        "nodeType": "chat/output",
        "name": "Install Result",
        "position": { "x": 1000, "y": 200 },
        "config": {}
      }
    ],
    "edges": [
      {
        "edgeId": "e100-input-to-llm",
        "sourceNode": "f1a0c0a0-6b3c-4c9f-9d0a-0c6d4f8f7a11",
        "sourcePort": "user_message",
        "targetNode": "c3d4e5f6-0002-4a00-9000-000000000002",
        "targetPort": "user_message"
      },
      {
        "edgeId": "e101-llm-to-install",
        "sourceNode": "c3d4e5f6-0002-4a00-9000-000000000002",
        "sourcePort": "response",
        "targetNode": "2c9b7ec8-df4f-4dbe-8ac5-2fa1b76595f2",
        "targetPort": "cli_name"
      },
      {
        "edgeId": "e102-install-to-output",
        "sourceNode": "2c9b7ec8-df4f-4dbe-8ac5-2fa1b76595f2",
        "sourcePort": "status",
        "targetNode": "f6a7b8c9-0005-4a00-9000-000000000005",
        "targetPort": "context"
      }
    ]
  }
}
