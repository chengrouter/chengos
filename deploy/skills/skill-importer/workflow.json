      {
        "nodeId": "5a59c2b1-88a9-54c7-a9bd-b967645e37bc",
        "nodeType": "agent/react_agent",
        "name": "Skill Import Agent",
        "position": { "x": 430, "y": 160 },
        "config": {
          "max_iterations": 20,
          "use_function_calling": true,
          "use_llm_evaluation": false,
          "instruction_prompt": "You are the ChengOS Skill Importer. Work only through the connected tools and keep the real workspace files as the source of truth. First call tools/fetch_repository with the user's repository URL, document URL, or pasted content and retain its exact package_path. Use tools/file_ops_hub to list and read package_path/source/** and any existing package files. Use tools/workflow_inspect when workflow.json needs registered node schemas or templates. Create or edit package_path/SKILL.md, package_path/skill.yaml, optional package_path/workflow.json, and optional package_path/references/** with file_ops_hub. Never write outside the configured Skills sandbox, never place credentials or secret values in files, and do not alter fetched source/**. skill.yaml must use schema_version \"1\", normalization.status needs_review, execution.auto_execute false, and source.path matching skills/<skill-name>/skill.yaml. Choose workflow, agentic, or reference backend conservatively; use only registered nodes and narrowly scoped tools. Call tools/validate_skill_spec with the exact package_path. If valid=false, repair every named file and field from the structured issues, then validate again. If the same issue_fingerprint remains after a genuine repair attempt, stop and report the unresolved issues instead of looping. On success report package_path, created/changed files, fetch or validation warnings, and remind the user that review is still required. The virtual todo_write tool is only for brief planning and is not a file writer. Never enable, execute, or publish an imported Skill."
        }
      },
      {
        "nodeId": "b03eec8f-33ed-40be-b407-1ca62bb6c37d",
        "nodeType": "tools/fetch_repository",
        "name": "Fetch Source",
        "position": { "x": 430, "y": 520 },
        "config": { "allow_insecure_schemes": false }
      },
      {
        "nodeId": "0bda562b-f5b3-4b62-905e-ab93746b90fc",
        "nodeType": "tools/file_ops_hub",
        "name": "Skill Workspace Files",
        "position": { "x": 760, "y": 520 },
        "config": {
          "sandbox_root": "skills",
          "allow_read_info": true,
          "allow_read_content": true,
          "allow_list_directory": true,
          "allow_search": true,
          "allow_file_tree": true,
          "allow_diff": true,
          "allow_validate": true,
          "allow_write": true,
          "allow_edit": true,
          "allow_patch": true,
          "allow_copy": false,
          "allow_backup": true,
          "allow_move": false,
          "allow_rollback": true,
          "allow_delete": false,
          "allow_batch": true,
          "require_approval": true,
          "config": { "create_backup": true, "create_backups": true }
        }
      },
      {
        "nodeId": "fc54ea14-7622-4ea1-912d-3d3fcd494a8e",
