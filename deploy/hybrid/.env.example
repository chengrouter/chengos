# ============================================================
# ChengOS Hybrid Deployment — Environment Template
# Copy to .env and fill in all values before running start.sh
# ============================================================

# ------------------------------------------------------------
# Infrastructure secrets (used by docker-compose and the app)
# Generate with: openssl rand -hex 16
# ------------------------------------------------------------
POSTGRES_PASSWORD=change_this_postgres_password
REDIS_PASSWORD=change_this_redis_password

# ------------------------------------------------------------
# Application connection strings (127.0.0.1 — infra via Docker)
# ------------------------------------------------------------
DATABASE_URL=postgres://tianai_db:change_this_postgres_password@127.0.0.1:5432/master_router
REDIS_URL=redis://:change_this_redis_password@127.0.0.1:6379
QDRANT_URL=http://127.0.0.1:6334

# Database Installation Mode & Switches
DB_INSTALL_MODE=managed-process  # 'managed-process' (local user sandbox) or 'system-service' (apt/systemd service)
ENABLE_REDIS=false
ENABLE_QDRANT=false
UI_PORT=8080
APP_PORT=5055

# Connection pool tuning
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_CONNECTION_TIMEOUT=30
REDIS_MAX_CONNECTIONS=10
REDIS_MIN_CONNECTIONS=1
REDIS_CONNECTION_TIMEOUT=30

# ------------------------------------------------------------
# Agent Memory (explicit host/port for agent memory nodes)
# ------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=master_router
DB_USER=tianai_db
DB_PASSWORD=change_this_postgres_password
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_DB=0

# ------------------------------------------------------------
# Required application secrets
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------
CREDENTIAL_MASTER_KEY_1=replace_with_64_hex_chars
JWT_SECRET=replace_with_64_hex_chars

# ------------------------------------------------------------
# Application server
# ------------------------------------------------------------
PORT=3000
BIND_ADDRESS=0.0.0.0

# ------------------------------------------------------------
# Runtime behaviour
# ------------------------------------------------------------
RUN_MIGRATIONS=true
RUST_LOG=info
RUST_BACKTRACE=1

# ------------------------------------------------------------
# Skills directory (relative to package root)
# ------------------------------------------------------------
SKILLS_DIR=./skills

# ------------------------------------------------------------
# Scheduler
# ------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_NODE_ID=node-1
SCHEDULER_HOT_WINDOW_SECS=60
SCHEDULER_WARM_WINDOW_SECS=300
SCHEDULER_SWEEPER_INTERVAL_SECS=30
SCHEDULER_LOCK_TIMEOUT_SECS=60
SCHEDULER_MAX_CONCURRENCY=8

# ------------------------------------------------------------
# CORS — set CORS_PERMISSIVE=false and list your origins in prod
# ------------------------------------------------------------
CORS_PERMISSIVE=true    
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# ------------------------------------------------------------
# MCP (optional)
# ------------------------------------------------------------
MCP_ENABLED=false
# MCP_SERVER_TOKEN=replace_with_a_long_random_token
# MCP_GATEWAY_PORT_START=9100

# ------------------------------------------------------------
# OAuth2 (optional)
# ------------------------------------------------------------
# OAUTH2_GOOGLE_CLIENT_ID=
# OAUTH2_GOOGLE_CLIENT_SECRET=
# OAUTH2_GITHUB_CLIENT_ID=
# OAUTH2_GITHUB_CLIENT_SECRET=
# OAUTH2_MICROSOFT_CLIENT_ID=
# OAUTH2_MICROSOFT_CLIENT_SECRET=
# OAUTH2_REDIRECT_URI=https://your-api.example.com/api/v1/oauth2/callback

# ------------------------------------------------------------
# Email (optional)
# ------------------------------------------------------------
EMAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=mailer@example.com
# SMTP_PASSWORD=change_me
# SMTP_FROM=mailer@example.com
# PASSWORD_RESET_BASE_URL=https://your-frontend.example.com/reset-password

# Enable Code Nodes
CHENG_ENABLE_CODE_PYTHON=true
CHENG_ENABLE_CODE_JS=true

# Allow private LLM endpoints (for self-hosted models)
ALLOW_PRIVATE_LLM_ENDPOINTS=true
