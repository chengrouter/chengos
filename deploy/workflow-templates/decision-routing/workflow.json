        "nodeType": "agent/react_agent",
        "name": "Email Agent",
        "position": {
          "x": 820,
          "y": 0
        },
        "config": {
          "instruction_prompt": "You are an email assistant. You can only use the mail tool. Read, search, summarize, draft, and send email exactly as the user asks; confirm before sending."
        }
      },
      {
        "nodeId": "10a81a00-164b-5ca6-a3e9-68a52b3cbcf9",
        "nodeType": "chat/output",
