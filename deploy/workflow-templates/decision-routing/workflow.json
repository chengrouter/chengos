{
  "schemaVersion": 1,
  "name": "decision_routing",
  "description": "[Experimental] Semantic routing with ai/decision_branch: each request goes to the smallest capable agent (email, weather, or code), each with only its own tools and prompt; ordinary, ambiguous, multi-intent, or low-confidence requests go to the general agent. Privacy: with the Jev provider the routed user request is sent to TypeSafe (hosted) on every turn. Needs a Jev credential or the deployment's JEV_API_KEY, a model on LLM Config, and mail/web tool credentials.",
  "tags": [
    "ai_chat",
    "experimental"
  ],
  "definition": {
    "nodes": [
      {
        "nodeId": "b9927906-2594-55b1-9bab-67c4c3ff0e10",
        "nodeType": "chat/input",
        "name": "Chat Input",
        "position": {
          "x": 0,
          "y": 300
        },
        "config": {}
      },
      {
        "nodeId": "28076814-f2a6-5f46-9ee6-fcb0cd774d40",
        "nodeType": "ai/decision_branch",
        "name": "Decision Branch",
        "position": {
          "x": 380,
          "y": 300
        },
        "config": {
          "provider": "jev",
          "jev_model": "jev-1.13.0",
          "routing_instruction": "Choose the route that can satisfy the user's current request with the least privilege. Choose `email` only when email must be read, searched, or acted on. Choose `weather` only when current or forecast weather data is needed. Choose `code` for authorized workspace file or code work. If the request needs more than one route, or none clearly matches, choose the fallback route.",
          "routes": [
            {
              "id": "email",
              "label": "Email",
              "description": "Read, search, summarize, or act on email."
            },
            {
              "id": "weather",
              "label": "Weather",
              "description": "Retrieve current or forecast weather data."
            },
            {
              "id": "code",
              "label": "Code",
              "description": "Inspect or change files in the authorized workspace."
            }
          ],
          "route_memory": "sticky",
          "threshold_mode": "calibrated",
          "failure_mode": "fallback",
          "timeout_ms": 1500
        }
      },
      {
        "nodeId": "8c27d2a5-bf1c-5a93-b8ee-b03153aad823",
        "nodeType": "ai/llm_config",
        "name": "LLM Config",
