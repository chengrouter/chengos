        "name": "Code Agent",
        "position": {
          "x": 820,
          "y": 440
        },
        "config": {
          "instruction_prompt": "You are a workspace coding assistant. Use the file tools to inspect and change files inside the authorized workspace; destructive operations pause for approval."
