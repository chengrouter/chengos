{
  "workflowId": "67f88f14-50ab-442d-bfa4-bdaaa2360182",
  "name": "memory_chat",
  "description": "Chat workflow with conversation memory. Loads and maintains conversation history through chat/memory (configurable window size, optional history search), sends context to an LLM for response generation, and persists replies via chat/save_reply. Used as the memory-enabled sub-workflow of main_chat.",
  "state": "active",
  "nodeCount": 6,
  "edgeCount": 5,
  "createdAt": "2026-06-17T07:47:34.587506979+00:00",
  "updatedAt": "2026-07-25T22:46:25.877045+00:00",
  "version": 1,
  "isFavorite": false,
  "isTemplate": true,
  "isDraft": false,
  "tags": [
    "ai_chat"
  ],
  "visibility": "private",
