# ============================================================
# ChengOS Docker Deployment - Environment Template
# Copy to .env and fill in all values before running docker compose.
# ============================================================

# Images published to Docker Hub.
CHENGOS_API_IMAGE=chengos/chengos:latest
CHENGOS_UI_IMAGE=chengos/chengos_ui:latest
CHENGOS_APP_IMAGE=chengos/chengos_app:latest

# Host ports for local/default deployment.
API_PORT=3000
UI_PORT=8080
APP_PORT=5055

# Database and Redis passwords.
# Generate strong values before production use.
POSTGRES_PASSWORD=change_this_postgres_password
REDIS_PASSWORD=change_this_redis_password

# Application connection strings inside the Docker network.
DATABASE_URL=postgres://tianai_db:change_this_postgres_password@postgres:5432/master_router
REDIS_URL=redis://:change_this_redis_password@redis:6379
QDRANT_URL=http://qdrant:6334

# Agent memory connection details inside the Docker network.
DB_HOST=postgres
DB_PORT=5432
DB_NAME=master_router
DB_USER=tianai_db
DB_PASSWORD=change_this_postgres_password
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_DB=0

# Required application secrets.
# Generate with: openssl rand -hex 32
CREDENTIAL_MASTER_KEY_1=replace_with_64_hex_chars
JWT_SECRET=replace_with_64_hex_chars

# API runtime.
PORT=3000
BIND_ADDRESS=0.0.0.0
RUN_MIGRATIONS=true
RUST_LOG=info
RUST_BACKTRACE=1
SKILLS_DIR=/app/skills

# Scheduler.
SCHEDULER_ENABLED=true
SCHEDULER_NODE_ID=docker-node-1
SCHEDULER_HOT_WINDOW_SECS=60
SCHEDULER_WARM_WINDOW_SECS=300
SCHEDULER_SWEEPER_INTERVAL_SECS=30
SCHEDULER_LOCK_TIMEOUT_SECS=60
SCHEDULER_MAX_CONCURRENCY=8

# CORS.
# Same-origin UI proxy mode does not need browser CORS.
# If browsers call the API domain directly, set this to your UI origin.
CORS_PERMISSIVE=false
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5055

# UI runtime. Relative paths keep browser traffic same-origin through Nginx.
UI_API_BASE_URL=/api/v1
UI_WS_URL=/ws

# App runtime.
APP_API_BASE_URL=/api/v1
APP_WS_URL=/ws/executions
APP_CHANNEL_ID=weather-app
APP_BOUND_WORKFLOW_ID=

# Public URLs for remote deployments. Used by docker-compose.remote.yml.
PUBLIC_UI_URL=https://chengos.example.com
PUBLIC_APP_URL=https://app.chengos.example.com
PUBLIC_API_URL=https://api.chengos.example.com

# Optional MCP.
MCP_ENABLED=false
# MCP_SERVER_TOKEN=replace_with_a_long_random_token
# MCP_GATEWAY_PORT_START=9100

# Optional OAuth2.
# OAUTH2_GOOGLE_CLIENT_ID=
# OAUTH2_GOOGLE_CLIENT_SECRET=
# OAUTH2_GITHUB_CLIENT_ID=
# OAUTH2_GITHUB_CLIENT_SECRET=
# OAUTH2_MICROSOFT_CLIENT_ID=
# OAUTH2_MICROSOFT_CLIENT_SECRET=
# OAUTH2_REDIRECT_URI=https://api.chengos.example.com/api/v1/oauth2/callback

# Optional email.
EMAIL_ENABLED=false
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=mailer@example.com
# SMTP_PASSWORD=change_me
# SMTP_FROM=mailer@example.com
# PASSWORD_RESET_BASE_URL=https://chengos.example.com/reset-password

# Code nodes / private model endpoints.
CHENG_ENABLE_CODE_PYTHON=true
CHENG_ENABLE_CODE_JS=true
ALLOW_PRIVATE_LLM_ENDPOINTS=true

# Container path mounted from ./workspace for Cheng CLI sessions.
CHENG_CLI_ALLOWED_ROOTS=/app/workspace
