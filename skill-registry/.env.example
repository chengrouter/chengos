# skill-registry environment variables. Env vars override config file values.
# Never commit real secrets.

# --- Required in production -------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/skill_registry
REDIS_URL=redis://127.0.0.1:6379/0
# HMAC secret used to hash publisher grant/API tokens (>= 32 random chars).
REGISTRY_TOKEN_HMAC_SECRET=
# HMAC key deriving privacy-preserving download-count buckets.
REGISTRY_COUNTER_HMAC_KEY=
# Bearer token for /api/v1/admin endpoints and `skill-registry admin`.
REGISTRY_ADMIN_TOKEN=

# --- Common overrides -------------------------------------------------------
# REGISTRY_ENVIRONMENT=production
# REGISTRY_CONFIG=/etc/skill-registry/production.toml
# REGISTRY_LISTEN=127.0.0.1:8300
# REGISTRY_PUBLIC_URL=https://skills.example.com
# REGISTRY_ARTIFACT_ROOT=/var/lib/skill-registry/artifacts
# REGISTRY_CORS_ALLOWED_ORIGINS=https://app.example.com
# REGISTRY_USE_X_ACCEL_REDIRECT=true
# Run this process as API-only (workers run elsewhere):
# REGISTRY_RUN_JOBS=false
# REGISTRY_REDIS_ENABLED=true
# REGISTRY_LOG_FORMAT=json
# RUST_LOG=info
