# logrotate policy for skill-registry when running outside systemd-journald
# (e.g. logging to a file via a supervisor). With systemd, prefer
# journald's built-in rotation and drop this file.
#
# Install as /etc/logrotate.d/skill-registry

/var/log/skill-registry/*.log {
    daily
    rotate 14
    maxsize 512M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su skill-registry skill-registry
}
