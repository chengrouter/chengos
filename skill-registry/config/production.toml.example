# skill-registry production configuration example.
# Copy to production.toml, review every value, and start with:
#   skill-registry serve --config /etc/skill-registry/production.toml
#
# SECURITY-SENSITIVE VALUES ARE NOT SET IN THIS FILE. Provide them via
# environment variables (systemd EnvironmentFile / docker secrets):
#   DATABASE_URL                 required
#   REDIS_URL                    required when redis.enabled = true
#   REGISTRY_TOKEN_HMAC_SECRET   required, >= 32 random chars
#   REGISTRY_COUNTER_HMAC_KEY    required, random
#   REGISTRY_ADMIN_TOKEN         required for admin API access

environment = "production"

[server]
listen = "127.0.0.1:8300"          # keep private; Nginx terminates TLS
public_url = "https://skills.example.com"
request_timeout_secs = 30
shutdown_timeout_secs = 45
max_json_body_bytes = 1048576
# Browser origins allowed for direct-mode reads (must be https).
cors_allowed_origins = ["https://app.example.com"]
# Production should serve artifacts via Nginx sendfile.
use_x_accel_redirect = true
x_accel_prefix = "/internal/artifacts"

[database]
max_connections = 24
min_connections = 2
acquire_timeout_secs = 5
require_migrations_applied = true

[redis]
enabled = true
connect_timeout_secs = 2

[artifacts]
root = "/var/lib/skill-registry/artifacts"
work_dir = "work"
max_archive_bytes = 20971520
max_expanded_bytes = 104857600
max_file_bytes = 20971520
max_files = 512
max_compression_ratio = 200
max_path_bytes = 256
max_path_depth = 8
upload_timeout_secs = 300
work_dir_quota_bytes = 2147483648
file_mode = "0640"

[auth]
grant_code_ttl_secs = 120
grant_token_ttl_secs = 7776000
assertion_max_age_secs = 60
jti_ttl_secs = 300

[cache]
search_ttl_secs = 30
release_ttl_secs = 3600
schema_version = 1

[rate_limit]
public_per_ip_per_min = 300
download_per_ip_per_min = 60
publish_per_publisher_per_min = 30
auth_per_ip_per_min = 20
report_per_ip_per_day = 20

[jobs]
run_jobs = true
max_concurrency = 8
scan_concurrency = 4
cleanup_concurrency = 1
lease_secs = 300
max_attempts = 5
retry_backoff_secs = 30
outbox_poll_interval_secs = 5
cleanup_min_age_secs = 86400
counter_flush_interval_secs = 300

[moderation]
auto_approve_clean_scans = false
quarantine_at_severity = "critical"

[counters]
window_secs = 86400

[telemetry]
log_format = "json"
log_filter = "info"
